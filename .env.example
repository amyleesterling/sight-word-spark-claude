# Server-side only. NEVER commit a real key and never expose it to the client.
# Used by the /api/tts endpoint (Cloudflare Pages Function in production,
# Vite dev middleware locally) to call the OpenAI Speech API.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin
